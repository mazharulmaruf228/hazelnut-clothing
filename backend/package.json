{
  "name": "catalogue-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --experimental-strip-types src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node scripts/integration.mjs",
    "test:prepare-e2e": "node --experimental-strip-types scripts/prepare-e2e.ts",
    "test:restore": "node scripts/restore-smoke.mjs",
    "dev:db": "node scripts/dev-db.mjs",
    "assets:cleanup": "node --env-file-if-exists=.env --experimental-strip-types src/cleanup.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env --experimental-strip-types prisma/seed.ts",
    "admin:create": "node --env-file-if-exists=.env --experimental-strip-types src/bootstrap.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "prisma": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.44.0",
    "cloudinary": "^2.8.0",
    "cookie-parser": "^1.4.7",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.0",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "sharp": "^0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "embedded-postgres": "^18.6.0-beta.19",
    "supertest": "^7.1.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
